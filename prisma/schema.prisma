generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // Hashed password for email/password auth (null for OAuth users)

  accounts      Account[]
  sessions      Session[]
  refreshTokens RefreshToken[]

  notes   Note[]
  stacks  Stack[]
  folders Folder[]
  tasks   Task[]
  calendarEvents CalendarEvent[]
  recordings Recording[]
  fileRecords FileRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId String?
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stack {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId String?
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  name    String
  columns StackColumn[]
  rows    StackRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderSubfolders")
  notes     Note[]
  stacks    Stack[]
  fileRecords FileRecord[]
  recordings Recording[]

  @@index([userId])
}

enum DataType {
  TEXT
  INT
  FLOAT
  BOOLEAN
  DATE
  SELECT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Task?  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children  Task[] @relation("TaskSubtasks")

  title       String
  description String       @default("") @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assignee    String?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentId])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model CalendarEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  notes   String   @default("") @db.Text
  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)
  color   String   @default("#5645d4")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
  @@index([userId, endAt])
}

model StackColumn {
  id      String   @id @default(uuid())
  stackId String
  stack   Stack    @relation(fields: [stackId], references: [id], onDelete: Cascade)

  name  String
  type  DataType?
  order Int      @default(0)
}

model StackRow {
  id      String @id @default(uuid())
  stackId String
  stack   Stack  @relation(fields: [stackId], references: [id], onDelete: Cascade)

  data Json @db.JsonB // Format: { [columnId]: value }
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ─── Records Feature ────────────────────────────────────────────────────────

enum RecordStatus {
  RECORDING
  TRANSCRIBING
  RESOLVING
  COMMITTED
}

model Recording {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String       @default("Untitled Recording")
  durationSec   Float        @default(0)
  transcript    String       @default("") @db.Text
  status        RecordStatus @default(RECORDING)
  audioKey      String?      // S3 key for the audio file (e.g. "records/abc123.wav")
  audioSizeBytes Int?        @map("audio_size_bytes")
  errorLog      String?      @map("error_log") @db.Text

  // Folder organisation
  folderId      String?      @map("folder_id")
  folder        Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Agentic Automate results (JSON payloads stored after AI processing)
  noteMutation        Json?   @map("note_mutation")        @db.JsonB
  taskMutations       Json?   @map("task_mutations")       @db.JsonB
  stackMutation       Json?   @map("stack_mutation")       @db.JsonB
  calendarMutation    Json?   @map("calendar_mutation")    @db.JsonB
  speakerLabels       Json?   @map("speaker_labels")       @db.JsonB

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")
  committedAt   DateTime? @map("committed_at")

  attachments   Attachment[]

  @@map("recordings")
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, folderId])
}

model Attachment {
  id            String     @id @default(uuid())
  recordingId   String     @map("recording_id")
  recording     Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId        String     @map("user_id")
  fileName      String     @map("file_name")
  mimeType      String     @map("mime_type")
  storageKey    String     @map("storage_key")  // S3 key
  sizeBytes     Int        @map("size_bytes")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("attachments")
  @@index([recordingId])
  @@index([userId])
}

// ─── Multi-Type File Storage ────────────────────────────────────────────────
//
// Polymorphic file record designed for unlimited extensibility:
//   • folderId   → places the file in the explorer tree (Folder hierarchy)
//   • entityType + entityId → links to ANY entity (note, recording, task,
//     stack, calendar event, or future types) without schema changes.
//
// Examples:
//   Attach image to a note:    entityType="note",    entityId="<noteId>"
//   Attach PDF to a task:      entityType="task",    entityId="<taskId>"
//   Attach audio to recording: entityType="recording", entityId="<recordingId>"
//   General asset (orphaned):  entityType=null,      entityId=null

model FileRecord {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Explorer-tree hierarchy (Folder the file lives in)
  folderId      String?
  folder        Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Polymorphic entity link — extensible to any current or future entity type
  // No FK constraint by design: new entity types work without schema migrations
  entityType    String?    // e.g. "note", "recording", "task", "stack", "calendar_event"
  entityId      String?    // the ID of the linked entity

  // File metadata
  fileName      String
  mimeType      String
  storageKey    String     // S3 key (e.g. "images/abc123.png")
  sizeBytes     Int
  assetFolder   String?    // logical S3 category: "images", "videos", "documents", "audio", "other"

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("file_records")
  @@index([userId])
  @@index([folderId])
  @@index([entityType, entityId])
  @@index([mimeType])
}

// ─────────────────────────────────────────────────────────────────────────────
// FastAPI-managed tables (NOT managed by Prisma — read-only from NextJS)
//
// These tables are owned by the Python FastAPI microservice.
// They are declared here so Prisma db push does NOT attempt to drop them.
// Do NOT use Prisma to write to these tables — FastAPI owns the schema.
// ─────────────────────────────────────────────────────────────────────────────

model Interaction {
  id           BigInt    @id @default(autoincrement())
  sessionId    String    @map("session_id") @db.VarChar(64)
  userId       String    @default("default") @map("user_id") @db.VarChar(64)
  timestamp    DateTime  @default(now()) @map("timestamp") @db.Timestamptz()
  transcript   String    @map("transcript") @db.Text
  contextType  String    @map("context_type") @db.VarChar(20)
  action       String    @map("action") @db.VarChar(50)
  params       Json      @default("{}") @map("params") @db.JsonB
  reply        String?   @map("reply") @db.Text
  language     String    @default("vi") @map("language") @db.VarChar(10)
  complexity   String    @default("simple") @map("complexity") @db.VarChar(20)
  durationMs   Float?    @map("duration_ms") @db.DoublePrecision
  success      Boolean   @default(true) @map("success")

  @@map("interactions")
  @@index([sessionId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([contextType])
  @@index([action])
}

model UserProfile {
  userId                  String   @id @default("default") @map("user_id") @db.VarChar(64)
  preferredLanguage       String   @default("vi") @map("preferred_language") @db.VarChar(10)
  frequentlyUsedActions   Json     @default("{}") @map("frequently_used_actions") @db.JsonB
  frequentlyUsedContexts  Json     @default("{}") @map("frequently_used_contexts") @db.JsonB
  commonWorkflows         Json     @default("[]") @map("common_workflows") @db.JsonB
  tonePreference          String   @default("command") @map("tone_preference") @db.VarChar(20)
  totalInteractions       Int      @default(0) @map("total_interactions")
  knownFacts              Json     @default("{}") @map("known_facts") @db.JsonB
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("user_profiles")
}
