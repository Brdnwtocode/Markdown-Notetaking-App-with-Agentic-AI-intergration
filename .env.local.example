# Database
DATABASE_URL="postgresql://user:password@localhost:5432/notetaking_app"

# NextAuth Configuration (v5 — uses AUTH_ prefix, not NEXTAUTH_)
AUTH_URL="http://localhost:3000/api/auth"
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-hex-32"
AUTH_TRUST_HOST=true

# OAuth Providers
AUTH_GITHUB_ID="your-github-oauth-app-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-secret"

AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# OpenAI API
NEXT_PUBLIC_OPENAI_API_KEY="sk-"
OPENAI_API_KEY="sk-"

# FastAPI Microservice
FASTAPI_URL="http://host.docker.internal:8000"

# ─── AWS S3 Storage ──────────────────────────────────────────────────────────
STORAGE_ENDPOINT="https://s3.<region>.amazonaws.com"
STORAGE_REGION="<region>"
STORAGE_BUCKET="markdown-note-app"
STORAGE_ACCESS_KEY="<aws-access-key>"
STORAGE_SECRET_KEY="<aws-secret-key>"
STORAGE_FORCE_PATH_STYLE="false"

# Deepgram (Voice-to-Text)
DEEPGRAM_API_KEY="your-deepgram-api-key"
